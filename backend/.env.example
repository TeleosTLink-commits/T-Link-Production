# ============================================================================
# T-Link Backend Environment Configuration
# ============================================================================
# SECURITY: Never commit the actual .env file to version control
# This is a template - copy to .env and fill in your actual values
#
# To generate secure secrets:
#   JWT_SECRET: openssl rand -base64 64
#   API Keys: Use service provider dashboards to generate
# ============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
# SECURITY: These credentials provide full database access - keep secure!
DB_HOST=your_database_host
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_SSL=true
# Optional: Custom CA certificate for SSL (if your database uses self-signed cert)
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\nYour CA cert here\n-----END CERTIFICATE-----

# Local Database Configuration (for migration/sync scripts only)
# Only needed if you run uploadSampleFiles.ts or similar migration scripts
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=tlink_db
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=your_local_password

# JWT Authentication
# SECURITY: Must be minimum 32 characters in production. Use a cryptographically random string.
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_RANDOM_256BIT_KEY_MINIMUM_32_CHARACTERS
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary Configuration (for file storage)
# SECURITY: API secret provides full control over your Cloudinary account
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Configuration (SMTP for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_specific_password
EMAIL_FROM=noreply@yourcompany.com

# FedEx API Configuration
# Use sandbox for testing: https://apis-sandbox.fedex.com
# Use production: https://apis.fedex.com
FEDEX_API_BASE_URL=https://apis-sandbox.fedex.com
FEDEX_ACCOUNT_NUMBER=your_fedex_account_number
FEDEX_API_KEY=your_fedex_api_key
FEDEX_SECRET_KEY=your_fedex_secret_key

# Lab Shipping Address (Ship FROM address)
LAB_ADDRESS_STREET=Your Street Address
LAB_ADDRESS_CITY=Your City
LAB_ADDRESS_STATE=YS
LAB_ADDRESS_ZIP=12345
LAB_ADDRESS_COUNTRY=US

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Notification Settings
EXPIRATION_WARNING_DAYS=30,60,90
LOW_INVENTORY_CHECK_INTERVAL=daily
SHIPMENT_NOTIFICATION_EMAIL=logistics@yourcompany.com

# ============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================================================
# Before deploying to production, ensure:
# [ ] JWT_SECRET is 64+ characters of random data (openssl rand -base64 64)
# [ ] All database credentials are unique and strong
# [ ] Cloudinary API secret is set correctly
# [ ] FedEx API is set to production URL and has valid production keys
# [ ] All xxxxx_PASSWORD fields are set with strong passwords
# [ ] DB_SSL=true for production databases
# [ ] NODE_ENV=production
# [ ] Never expose this .env file publicly
# ============================================================================

